pipeline {
    agent any

    stages {

        stage('Compilar proyecto') {
            steps {
                dir('mesadepartes') {
                    // Usamos el Maven Wrapper para asegurar la versión correcta
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Ejecutar pruebas') {
            steps {
                dir('mesadepartes') {
                    sh 'chmod +x mvnw'
                    sh './mvnw test'
                }
            }
            post {
                always {
                    // Publica los reportes de pruebas en Jenkins
                    junit 'mesadepartes/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Análisis de calidad') {
            steps {
                dir('mesadepartes') {
                    // Ejecuta análisis de SonarQube usando el servidor configurado en Jenkins
                    withSonarQubeEnv('SonarQube') {
                        sh './mvnw clean verify sonar:sonar -Dsonar.projectKey=mesadepartes'
                    }
                }
            }
        }
    }
}
