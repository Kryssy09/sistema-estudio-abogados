pipeline {
    agent any

    stages {

        stage('Compilar proyecto') {
            steps {
                dir('sistema-estudio-abogados') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Ejecutar pruebas') {
            steps {
                dir('sistema-estudio-abogados') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit 'sistema-estudio-abogados/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Análisis de calidad') {
            steps {
                dir('sistema-estudio-abogados') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn clean verify sonar:sonar -Dsonar.projectKey=sistema-estudio-abogados'
                    }
                }
            }
        }
    }
}
